# Install as the HTTPS virtual host for shotimer.io after confirming the
# certificate paths. The complete origin is proxied to Node because Shotimer's
# server owns static routing, auth callbacks, manifests, the waitlist API and
# the protected live relay.

upstream shotimer_node {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name shotimer.io www.shotimer.io app.shotimer.io;
    return 301 https://shotimer.io$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name shotimer.io www.shotimer.io app.shotimer.io;

    ssl_certificate /etc/letsencrypt/live/shotimer.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shotimer.io/privkey.pem;

    location / {
        proxy_pass http://shotimer_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;

        # Required for the protected live-room Server-Sent Events stream.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no always;
    }
}
